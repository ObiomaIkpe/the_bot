# Postgres connection
DATABASE_URL=postgresql+psycopg2://bot_user:changeme@localhost:5432/trading_bot

# JWT auth (users.password_hash / login tokens)
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Symmetric key for encrypting broker_credentials at rest (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Log output format: "text" (human-readable, default -- good for local dev)
# or "json" (structured, one JSON object per line -- good for environments
# that ingest structured logs, e.g. CloudWatch/Loki/Datadog).
LOG_FORMAT=text

# Monitoring/alerting (logging/audit review part 3). All optional -- leave
# unset and everything below no-ops safely (one warning log at first use,
# no real network calls). See PENDING_ITEMS.md for the full setup steps
# (create a Telegram bot via @BotFather, add it to a group, create two
# healthchecks.io checks).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# One check per service in healthchecks.io -- api and shadow_runner get
# DIFFERENT ping URLs. This shared env var name is overridden per-service
# in docker-compose.yml's `environment:` block, not set globally here.
HEALTHCHECKS_PING_URL=
