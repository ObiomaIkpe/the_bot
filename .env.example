# Postgres connection
DATABASE_URL=postgresql+psycopg2://bot_user:changeme@localhost:5432/trading_bot

# JWT auth (users.password_hash / login tokens)
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Symmetric key for encrypting broker_credentials at rest (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# shadow_runner's own config -- read directly via os.environ, not
# through app.core.config.Settings (see shadow_runner/config.py).
# Moved here from docker-compose.yml's shadow_runner-only `environment:`
# block (2026-09-04) so changing either is a server-side .env edit +
# restart, not a code change + deploy -- see DEDICATED_REFERENCE_ACCOUNT.md
# for why this actually got changed once already (the price-only
# reference account cutover).
BRIDGE_URL=http://<windows-vps-ip>:<bridge-worker-port>
SHADOW_RUNNER_USER_ID=replace-with-the-real-user-id-shadow_runner-journals-against

# Log output format: "text" (human-readable, default -- good for local dev)
# or "json" (structured, one JSON object per line -- good for environments
# that ingest structured logs, e.g. CloudWatch/Loki/Datadog).
LOG_FORMAT=text

# Monitoring/alerting (logging/audit review part 3). All optional -- leave
# unset and everything below no-ops safely (one warning log at first use,
# no real network calls). See PENDING_ITEMS.md for the full setup steps
# (create a Telegram bot via @BotFather, add it to a group, create two
# healthchecks.io checks).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# One check per service in healthchecks.io -- api and shadow_runner get
# DIFFERENT ping URLs (format: https://hc-ping.com/<uuid>). Each is
# interpolated into that service's own HEALTHCHECKS_PING_URL in
# docker-compose.yml's `environment:` block -- these two names only
# exist here as the interpolation source, not read directly by app code.
HEALTHCHECKS_PING_URL_API=
HEALTHCHECKS_PING_URL_SHADOW_RUNNER=
